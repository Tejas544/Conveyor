<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.conveyor</groupId>
  <artifactId>conveyor-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Conveyor</name>
  <description>
    Cloud-native, event-driven order fulfillment platform. Saga-pattern
    distributed transactions over Kafka, polyglot persistence, and a
    live ops dashboard. See ARCHITECTURE.md for the full design.
  </description>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- ADR-4: Spring Boot 3.5.x. Pinned to the latest 3.5 patch available
         at the time Phase 1 was scaffolded (recorded in CONTEXT.md). -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <modules>
    <module>conveyor-contracts</module>
    <module>conveyor-common</module>
    <module>order-service</module>
    <module>inventory-service</module>
    <module>payment-service</module>
    <module>saga-orchestrator</module>
    <module>dispatch-service</module>
    <!-- e2e is deliberately NOT a reactor module: every service's Dockerfile COPYs only the
         pom.xml files it needs to resolve its own `-am` build inside the image, and e2e has no
         compile dependency on any of them (it drives the whole stack over HTTP) — adding it here
         would break every Dockerfile's `mvnw -pl <service> -am` step, which reads the *whole*
         reactor's module list before `-pl` filtering. Built standalone:
         `mvnw -f e2e/pom.xml verify -DskipE2E=false` (see e2e/pom.xml and .github/workflows/build.yml). -->
  </modules>

  <properties>
    <!-- ADR-4: Java 21 LTS is the target bytecode release, compiled with
         whatever JDK is available locally (JDK 25 on this machine) via the
         compiler release flag, which is fully supported and produces
         identical output to compiling with a JDK 21 toolchain. -->
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <testcontainers.version>1.20.4</testcontainers.version>
    <springdoc.version>2.7.0</springdoc.version>
    <spotless.version>3.10.2</spotless.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>com.conveyor</groupId>
        <artifactId>conveyor-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.conveyor</groupId>
        <artifactId>conveyor-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <!-- AbstractIntegrationTest etc. — see conveyor-common/pom.xml for why
             its Testcontainers dependencies are compile-scope. -->
        <groupId>com.conveyor</groupId>
        <artifactId>conveyor-common</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat/>
              <removeUnusedImports/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- BUGS.md (this machine's Docker Desktop/WSL2 environment): a shared JVM fork
                 running more than one Testcontainers-backed @SpringBootTest class reliably
                 breaks the Postgres container's mapped port for every class after the first,
                 even with identical, cached Spring context reuse and a shrunk connection pool.
                 A fresh fork per test class gives every class its own containers and sidesteps
                 it — slower, but correctness over speed for an environment-specific bug that
                 isn't fixable from application code. -->
            <reuseForks>false</reuseForks>
            <forkCount>1</forkCount>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <violationSeverity>warning</violationSeverity>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
