<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.conveyor</groupId>
  <artifactId>conveyor-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Conveyor</name>
  <description>
    Cloud-native, event-driven order fulfillment platform. Saga-pattern
    distributed transactions over Kafka, polyglot persistence, and a
    live ops dashboard. See ARCHITECTURE.md for the full design.
  </description>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- ADR-4: Spring Boot 3.5.x. Pinned to the latest 3.5 patch available
         at the time Phase 1 was scaffolded (recorded in CONTEXT.md). -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <modules>
    <module>conveyor-contracts</module>
    <module>conveyor-common</module>
    <module>order-service</module>
    <module>inventory-service</module>
    <module>payment-service</module>
    <module>saga-orchestrator</module>
    <module>dispatch-service</module>
    <module>conveyor-verifier</module>
    <!-- e2e is deliberately NOT a reactor module: every service's Dockerfile COPYs only the
         pom.xml files it needs to resolve its own `-am` build inside the image, and e2e has no
         compile dependency on any of them (it drives the whole stack over HTTP) — adding it here
         would break every Dockerfile's `mvnw -pl <service> -am` step, which reads the *whole*
         reactor's module list before `-pl` filtering. Built standalone:
         `mvnw -f e2e/pom.xml verify -DskipE2E=false` (see e2e/pom.xml and .github/workflows/build.yml). -->
  </modules>

  <properties>
    <!-- ADR-4: Java 21 LTS is the target bytecode release, compiled with
         whatever JDK is available locally (JDK 25 on this machine) via the
         compiler release flag, which is fully supported and produces
         identical output to compiling with a JDK 21 toolchain. -->
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <testcontainers.version>1.20.4</testcontainers.version>
    <springdoc.version>2.7.0</springdoc.version>
    <spotless.version>3.10.2</spotless.version>

    <!-- Phase 13, BUG-0035: Trivy found these two at the versions spring-boot-starter-parent
         3.5.16 itself still pins (tomcat 10.1.55, postgresql-jdbc 42.7.11) carrying HIGH/CRITICAL
         CVEs already fixed upstream; overriding the parent's own property is the normal Spring
         Boot mechanism for this, not a fork of the BOM. -->
    <!-- 10.1.58 (Trivy's own reported fixed-version) was never published to Maven Central; 10.1.59
         is the next release that is and includes the same fixes. -->
    <tomcat.version>10.1.59</tomcat.version>
    <postgresql.version>42.7.12</postgresql.version>

    <!-- Phase 13 (CLAUDE.md §7, PLAN.md "images are reproducible: same commit -> same digest"):
         maven-jar-plugin and spring-boot-maven-plugin both stamp the jar's ZIP-entry timestamps
         from the build clock by default, which alone makes two builds of the identical commit
         produce different jar bytes and therefore different image layer digests. A fixed
         constant (not tied to HEAD's commit time) is the simplest form of the standard
         Reproducible-Builds Maven convention and is sufficient here: this property only has to
         make two builds of the *same* tree byte-identical, not encode when that tree was
         committed. -->
    <project.build.outputTimestamp>2024-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Internal modules -->
      <dependency>
        <groupId>com.conveyor</groupId>
        <artifactId>conveyor-contracts</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.conveyor</groupId>
        <artifactId>conveyor-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <!-- AbstractIntegrationTest etc. — see conveyor-common/pom.xml for why
             its Testcontainers dependencies are compile-scope. -->
        <groupId>com.conveyor</groupId>
        <artifactId>conveyor-common</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <!-- BUG-0035: conveyor-common declares Testcontainers compile-scope on purpose (see its
               pom.xml) so every service's own tests get it transitively without redeclaring it,
               but "compile scope" also means Spring Boot's repackage goal was bundling the whole
               ~18MB testcontainers.jar plus docker-java's HTTP transport (which shades a
               known-CVE-vulnerable httpcore5 5.0.2, invisible to `mvnw dependency:tree` since it's
               shaded inside another jar, not a direct Maven dependency) into every one of the six
               *production* container images, undetected until this phase's Trivy scan actually
               looked inside them. excludeGroupIds here trims the repackaged executable jar only;
               the compile/test classpath, and therefore every service's own Testcontainers-backed
               test suite, is completely unaffected. -->
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <configuration>
            <excludeGroupIds>org.testcontainers,com.github.docker-java,net.java.dev.jna</excludeGroupIds>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
          <configuration>
            <java>
              <googleJavaFormat/>
              <removeUnusedImports/>
            </java>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!-- BUGS.md (this machine's Docker Desktop/WSL2 environment): a shared JVM fork
                 running more than one Testcontainers-backed @SpringBootTest class reliably
                 breaks the Postgres container's mapped port for every class after the first,
                 even with identical, cached Spring context reuse and a shrunk connection pool.
                 A fresh fork per test class gives every class its own containers and sidesteps
                 it — slower, but correctness over speed for an environment-specific bug that
                 isn't fixable from application code. -->
            <reuseForks>false</reuseForks>
            <forkCount>1</forkCount>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>3.6.0</version>
        <configuration>
          <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <violationSeverity>warning</violationSeverity>
          <failOnViolation>true</failOnViolation>
        </configuration>
        <executions>
          <execution>
            <id>checkstyle-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
