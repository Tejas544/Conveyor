{
  "title": "Conveyor / Saga Health",
  "uid": "conveyor-saga-health",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "tags": ["conveyor"],
  "panels": [
    {
      "id": 1,
      "title": "Saga throughput by terminal outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(conveyor_saga_terminal_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Saga duration (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, outcome) (rate(conveyor_saga_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{outcome}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(conveyor_saga_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{outcome}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(conveyor_saga_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{outcome}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Compensation correctness rate (ABORTED / (ABORTED + NEEDS_INTERVENTION))",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.99 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(conveyor_saga_terminal_total{outcome=\"ABORTED\"}[1h])) / (sum(increase(conveyor_saga_terminal_total{outcome=\"ABORTED\"}[1h])) + sum(increase(conveyor_saga_terminal_total{outcome=\"NEEDS_INTERVENTION\"}[1h])))",
          "legendFormat": "compensation correctness"
        }
      ]
    },
    {
      "id": 4,
      "title": "Sagas currently active",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "conveyor_saga_active", "legendFormat": "active" }]
    },
    {
      "id": 5,
      "title": "Sagas needing intervention",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "conveyor_saga_needs_intervention", "legendFormat": "needs intervention" }
      ]
    },
    {
      "id": 6,
      "title": "Saga step timeouts",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(conveyor_saga_timeouts_total[1h]))",
          "legendFormat": "timeouts (1h)"
        }
      ]
    }
  ]
}
