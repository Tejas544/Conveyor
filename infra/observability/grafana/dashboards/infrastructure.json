{
  "title": "Conveyor / Infrastructure",
  "uid": "conveyor-infrastructure",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "5s",
  "tags": ["conveyor"],
  "panels": [
    {
      "id": 1,
      "title": "Outbox publish lag (oldest unpublished row age)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "expr": "conveyor_outbox_lag_seconds",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Dead-letter messages by topic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (topic) (increase(conveyor_dlq_messages_total[5m]))",
          "legendFormat": "{{topic}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Inbox duplicates absorbed, by consumer",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (consumer) (rate(conveyor_inbox_duplicates_total[5m]))",
          "legendFormat": "{{consumer}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Low-stock SKUs (available <= reorder level)",
      "type": "table",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "conveyor_stock_available",
          "format": "table",
          "instant": true,
          "legendFormat": "{{sku}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Kafka consumer lag, by group/topic",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (application, spring_id) (kafka_consumer_fetch_manager_records_lag)",
          "legendFormat": "{{application}} {{spring_id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "JVM heap used, by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "{{application}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Process CPU usage, by service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "process_cpu_usage{application!=\"\"}",
          "legendFormat": "{{application}}"
        }
      ]
    }
  ]
}
