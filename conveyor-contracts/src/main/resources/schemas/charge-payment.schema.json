{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conveyor.internal/schemas/charge-payment.schema.json",
  "title": "ChargePayment",
  "description": "ARCHITECTURE.md §6.1, §6.3. The envelope shape with eventType/payload constrained for the ChargePayment command.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "ChargePayment" },
        "schemaVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["amount", "currency", "paymentMethodToken", "idempotencyKey"],
          "properties": {
            "amount": { "type": "number", "exclusiveMinimum": 0 },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "paymentMethodToken": { "type": "string", "minLength": 1 },
            "idempotencyKey": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
