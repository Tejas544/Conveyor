{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conveyor.internal/schemas/reserve-inventory.schema.json",
  "title": "ReserveInventory",
  "description": "ARCHITECTURE.md §6.1, §6.3. The envelope shape with eventType/payload constrained for the ReserveInventory command.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "ReserveInventory" },
        "schemaVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["items"],
          "properties": {
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["sku", "quantity"],
                "properties": {
                  "sku": { "type": "string", "minLength": 1 },
                  "quantity": { "type": "integer", "minimum": 1 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
