{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conveyor.internal/schemas/release-inventory.schema.json",
  "title": "ReleaseInventory",
  "description": "ARCHITECTURE.md §6.1, §6.3. The envelope shape with eventType/payload constrained for the ReleaseInventory command.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "ReleaseInventory" },
        "schemaVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["reservationIds"],
          "properties": {
            "reservationIds": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "format": "uuid" }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
