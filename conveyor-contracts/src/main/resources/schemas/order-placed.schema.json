{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conveyor.internal/schemas/order-placed.schema.json",
  "title": "OrderPlaced",
  "description": "ARCHITECTURE.md §6.1, §6.3. The envelope shape with eventType/payload constrained for OrderPlaced.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "OrderPlaced" },
        "schemaVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["customerId", "items", "totalAmount", "currency", "shippingAddress", "paymentMethodToken"],
          "properties": {
            "customerId": { "type": "string", "format": "uuid" },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["sku", "quantity", "unitPrice"],
                "properties": {
                  "sku": { "type": "string", "minLength": 1 },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "unitPrice": { "type": "number", "exclusiveMinimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "totalAmount": { "type": "number", "exclusiveMinimum": 0 },
            "currency": { "type": "string", "minLength": 3, "maxLength": 3 },
            "shippingAddress": {
              "type": "object",
              "required": ["line1", "city", "postalCode", "country"],
              "properties": {
                "line1": { "type": "string", "minLength": 1 },
                "city": { "type": "string", "minLength": 1 },
                "postalCode": { "type": "string", "minLength": 1 },
                "country": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            },
            "paymentMethodToken": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
