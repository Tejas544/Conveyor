{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conveyor.internal/schemas/shipment-created.schema.json",
  "title": "ShipmentCreated",
  "description": "ARCHITECTURE.md §6.1, §6.3. The envelope shape with eventType/payload constrained for ShipmentCreated — dispatch-service's post-pivot, retriable step (§7.3).",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "ShipmentCreated" },
        "schemaVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["shipmentId", "carrier", "trackingNumber"],
          "properties": {
            "shipmentId": { "type": "string", "format": "uuid" },
            "carrier": { "type": "string", "minLength": 1 },
            "trackingNumber": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
