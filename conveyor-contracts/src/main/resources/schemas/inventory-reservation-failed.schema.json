{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conveyor.internal/schemas/inventory-reservation-failed.schema.json",
  "title": "InventoryReservationFailed",
  "description": "ARCHITECTURE.md §6.1, §6.3. The envelope shape with eventType/payload constrained for InventoryReservationFailed.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "InventoryReservationFailed" },
        "schemaVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["reason", "shortfalls"],
          "properties": {
            "reason": { "type": "string", "enum": ["INSUFFICIENT_STOCK", "UNKNOWN_SKU"] },
            "shortfalls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["sku", "requested", "available"],
                "properties": {
                  "sku": { "type": "string", "minLength": 1 },
                  "requested": { "type": "integer", "minimum": 1 },
                  "available": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
