{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conveyor.internal/schemas/payment-failed.schema.json",
  "title": "PaymentFailed",
  "description": "ARCHITECTURE.md §6.1, §6.3. The envelope shape with eventType/payload constrained for PaymentFailed.",
  "allOf": [
    { "$ref": "envelope.schema.json" },
    {
      "type": "object",
      "properties": {
        "eventType": { "const": "PaymentFailed" },
        "schemaVersion": { "const": 1 },
        "payload": {
          "type": "object",
          "required": ["reason", "retryable"],
          "properties": {
            "reason": { "type": "string", "enum": ["DECLINED", "GATEWAY_ERROR", "TIMEOUT"] },
            "retryable": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
