# Copy to .env for local docker-compose use. Never commit the real .env
# (CLAUDE.md §2.11 — config via environment variables, no secrets in code).

# --- Postgres (one instance, one database + role per service — ARCHITECTURE.md §4) ---
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev_only

ORDER_DB_NAME=order_service
ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=order_service_local_dev_only

INVENTORY_DB_NAME=inventory_service
INVENTORY_DB_USER=inventory_service
INVENTORY_DB_PASSWORD=inventory_service_local_dev_only

PAYMENT_DB_NAME=payment_service
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=payment_service_local_dev_only

SAGA_DB_NAME=saga_orchestrator
SAGA_DB_USER=saga_orchestrator
SAGA_DB_PASSWORD=saga_orchestrator_local_dev_only

DISPATCH_DB_NAME=dispatch_service
DISPATCH_DB_USER=dispatch_service
DISPATCH_DB_PASSWORD=dispatch_service_local_dev_only

# conveyor-verifier (Phase 10): SELECT-only across every service schema,
# never the owning service's own role (ARCHITECTURE.md §12).
VERIFIER_DB_USER=conveyor_verifier
VERIFIER_DB_PASSWORD=verifier_local_dev_only

# --- MongoDB (local container; Atlas M0 in the deployed path — ADR-3) ---
MONGO_INITDB_ROOT_USERNAME=conveyor
MONGO_INITDB_ROOT_PASSWORD=mongo_local_dev_only

# --- Kafka / Redpanda (ADR-2) ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# --- Auth (ADR-5) ---
# RS256 verification key every service's resource server trusts, base64 X.509
# SubjectPublicKeyInfo DER (no PEM headers/newlines). Unset = the committed
# demo/dev keypair baked into conveyor-common's JwtSecurityProperties (a public
# key is not a secret; the matching private key never appears in application
# code — see conveyor-common's TestJwtSupport test-jar helper). Override this
# for anything beyond local/demo use, per ARCHITECTURE.md §12's "mounted
# Secret, never generated at startup" posture. Token *issuance* (POST
# /auth/login, a JWKS endpoint) is not implemented yet — see CONTEXT.md's Key
# Decisions Log; until it lands, tokens only ever come from TestJwtSupport.
CONVEYOR_SECURITY_JWT_PUBLIC_KEY_PEM=

# --- make seed (PLAN.md Phase 2) — demo accounts only, never real credentials ---
SEED_OPS_USERNAME=ops
SEED_OPS_PASSWORD=ops_local_dev_only
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin_local_dev_only

# --- Chaos injection (ARCHITECTURE.md §14) — leave unset for normal runs ---
CONVEYOR_CHAOS_CRASH_AT=
CONVEYOR_CHAOS_CRASH_PROBABILITY=1.0
CONVEYOR_CHAOS_DELAY_AT=
