# Copy to .env for local docker-compose use. Never commit the real .env
# (CLAUDE.md §2.11 — config via environment variables, no secrets in code).

# --- Postgres (one instance, one database + role per service — ARCHITECTURE.md §4) ---
POSTGRES_SUPERUSER_PASSWORD=postgres_local_dev_only

ORDER_DB_NAME=order_service
ORDER_DB_USER=order_service
ORDER_DB_PASSWORD=order_service_local_dev_only

INVENTORY_DB_NAME=inventory_service
INVENTORY_DB_USER=inventory_service
INVENTORY_DB_PASSWORD=inventory_service_local_dev_only

PAYMENT_DB_NAME=payment_service
PAYMENT_DB_USER=payment_service
PAYMENT_DB_PASSWORD=payment_service_local_dev_only

SAGA_DB_NAME=saga_orchestrator
SAGA_DB_USER=saga_orchestrator
SAGA_DB_PASSWORD=saga_orchestrator_local_dev_only

DISPATCH_DB_NAME=dispatch_service
DISPATCH_DB_USER=dispatch_service
DISPATCH_DB_PASSWORD=dispatch_service_local_dev_only

# conveyor-verifier (Phase 10): SELECT-only across every service schema,
# never the owning service's own role (ARCHITECTURE.md §12).
VERIFIER_DB_USER=conveyor_verifier
VERIFIER_DB_PASSWORD=verifier_local_dev_only

# --- conveyor-verifier (Phase 10) — outside-in mode's REST base URLs. docker-compose.yml already
# points these at the compose network's service names; only relevant if you run the jar directly
# against a stack whose services live somewhere else. ---
# ORDER_SERVICE_BASE_URL=http://localhost:8081/api/v1
# INVENTORY_SERVICE_BASE_URL=http://localhost:8082/api/v1
# PAYMENT_SERVICE_BASE_URL=http://localhost:8083/api/v1
# SAGA_SERVICE_BASE_URL=http://localhost:8084/api/v1
# DISPATCH_SERVICE_BASE_URL=http://localhost:8085/api/v1

# --- MongoDB (local container; Atlas M0 in the deployed path — ADR-3) ---
MONGO_INITDB_ROOT_USERNAME=conveyor
MONGO_INITDB_ROOT_PASSWORD=mongo_local_dev_only

# --- Kafka / Redpanda (ADR-2) ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# --- Auth (ADR-5) ---
# RS256 verification key every service's resource server trusts, base64 X.509
# SubjectPublicKeyInfo DER (no PEM headers/newlines). Unset = the committed
# demo/dev keypair baked into conveyor-common's JwtSecurityProperties. Override
# this for anything beyond local/demo use, per ARCHITECTURE.md §12's "mounted
# Secret, never generated at startup" posture.
CONVEYOR_SECURITY_JWT_PUBLIC_KEY_PEM=

# The matching private half, PKCS8 base64 DER (no PEM headers/newlines).
# order-service is the only service that reads this — it is the sole token
# issuer (POST /auth/login, ADR-5). Unset = the committed demo/dev private key
# baked into order-service's JwtIssuerProperties (paired with the public key
# above). Never override with a real production key via plain env var — use a
# mounted Secret, same posture as the public key.
CONVEYOR_SECURITY_JWT_PRIVATE_KEY_PEM=

# --- make seed (PLAN.md Phase 2) — demo accounts only, never real credentials ---
SEED_OPS_USERNAME=ops
SEED_OPS_PASSWORD=ops_local_dev_only
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin_local_dev_only

# --- Chaos injection (ARCHITECTURE.md §14) — leave unset for normal runs ---
CONVEYOR_CHAOS_CRASH_AT=
CONVEYOR_CHAOS_CRASH_PROBABILITY=1.0
CONVEYOR_CHAOS_DELAY_AT=

# --- CORS (Phase 14, docs/DEPLOYMENT.md) — origins allowed to call this stack cross-origin, e.g.
# the statically-hosted dashboard on GitHub Pages, or the frontend's own local `npm run dev`
# (Vite on http://localhost:5173, proxied to these ports). Comma-separated. Defaults to both so
# README's own two documented ways to see the dashboard live (GitHub Pages, and `npm run dev`
# against this stack) work with no extra configuration (BUG-0051 — the Pages-only default silently
# broke the second one since Phase 14, found live in Phase 16 verifying README's own quickstart).
CONVEYOR_SECURITY_CORS_ALLOWED_ORIGINS=https://tejas544.github.io,http://localhost:5173

# --- Observability (ARCHITECTURE.md §11, Phase 9) ---
# Tracing is always on (not gated by `--profile observability`) so every log
# line carries traceId/spanId regardless of whether anything is listening;
# these two just control the sampling rate and where spans are shipped.
# Defaults already point at the `observability` profile's own Tempo container.
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://tempo:4318/v1/traces
