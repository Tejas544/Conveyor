# BUG-0042: openapi-typescript@7.13.0's peer range (typescript@^5.x) hasn't caught up to the
# typescript@~6.0.2 this project actually builds and tests against -- `npm install` has always
# tolerated this silently (npm 7+'s default is to warn, not fail, on install), but `npm ci` (used
# by CI, never run against this lockfile until Phase 14 added a frontend CI job) enforces it
# strictly and fails outright. legacy-peer-deps makes explicit what was already implicitly true
# locally the entire time, rather than downgrading a compiler version that already builds clean.
legacy-peer-deps=true
